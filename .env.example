# =================================================================
# USD/IDR Scraper & API Configuration Example
# Salin file ini menjadi .env lalu sesuaikan nilainya sesuai kebutuhan
# =================================================================

# Environment: development / production
ENVIRONMENT=development

# Database Connection
# SQLite Default (disimpan di folder ./data/):
DATABASE_URL=sqlite:///./data/exchange_rates.db
# Atau PostgreSQL jika migrasi ke server produksi:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/usdidr_db

# Scraper Settings
SCRAPE_URL=https://www.google.com/finance/quote/USD-IDR?hl=en
PAIR_NAME=USD/IDR
POLL_INTERVAL_SECONDS=5
REQUEST_TIMEOUT_SECONDS=10
MAX_RETRIES=3
PLAYWRIGHT_HEADLESS=true

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
# Domain website Anda yang diizinkan mengakses API via CORS (pisahkan dengan koma jika lebih dari satu)
# Gunakan * untuk mengizinkan semua domain (cocok untuk testing/development)
CORS_ALLOWED_ORIGINS=*
# Contoh untuk domain spesifik:
# CORS_ALLOWED_ORIGINS=https://mywebsite.com,https://dashboard.mywebsite.com,http://localhost:3000

# Logging Settings
LOG_LEVEL=INFO
LOG_DIR=./logs
