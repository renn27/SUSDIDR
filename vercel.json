{
  "version": 2,
  "builds": [
    {
      "src": "api/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/main.py"
    }
  ],
  "env": {
    "RUN_POLLER_IN_APP": "false",
    "ENVIRONMENT": "production",
    "CORS_ALLOWED_ORIGINS": "*"
  }
}
